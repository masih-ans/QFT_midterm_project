Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Load", " ", "packages"}], "*)"}], 
  RowBox[{
   RowBox[{"<<", "FeynArts`"}], "\n", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Generate", " ", "only", " ", "1", "PI", " ", "one"}], "-", 
     RowBox[{"loop", " ", "topologies"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"top2", "=", 
     RowBox[{"CreateTopologies", "[", 
      RowBox[{"1", ",", 
       RowBox[{"1", "->", "1"}], ",", 
       RowBox[{"ExcludeTopologies", "->", "Internal"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"top4", "=", 
     RowBox[{"CreateTopologies", "[", 
      RowBox[{"1", ",", 
       RowBox[{"2", "->", "2"}], ",", 
       RowBox[{"ExcludeTopologies", "->", "Internal"}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Insert", " ", "the", " ", "real", " ", "scalar", " ", "field"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diag2", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{"top2", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"S", "[", "1", "]"}], "}"}]}], ",", 
       RowBox[{"Model", "->", "\"\<Phi4\>\""}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diag4", "=", 
     RowBox[{"InsertFields", "[", 
      RowBox[{"top4", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"S", "[", "1", "]"}], ",", 
          RowBox[{"S", "[", "1", "]"}]}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"S", "[", "1", "]"}], ",", 
          RowBox[{"S", "[", "1", "]"}]}], "}"}]}], ",", 
       RowBox[{"Model", "->", "\"\<Phi4\>\""}], ",", 
       RowBox[{"InsertionLevel", "->", 
        RowBox[{"{", "Classes", "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Display", " ", "diagrams"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Paint", "[", 
     RowBox[{"diag2", ",", 
      RowBox[{"Numbering", "->", "Simple"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Paint", "[", 
     RowBox[{"diag4", ",", 
      RowBox[{"Numbering", "->", "Simple"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "FeynArts", " ", "amplitudes"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"faAmp2", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"diag2", ",", 
       RowBox[{"Truncated", "->", "True"}], ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"faAmp4", "=", 
     RowBox[{"CreateFeynAmp", "[", 
      RowBox[{"diag4", ",", 
       RowBox[{"Truncated", "->", "True"}], ",", 
       RowBox[{"PreFactor", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Convert", " ", "to", " ", "FeynCalc", " ", "notation"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"amp2", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"faAmp2", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", "p", "}"}]}], ",", 
       RowBox[{"OutgoingMomenta", "->", 
        RowBox[{"{", "p", "}"}]}], ",", 
       RowBox[{"LoopMomenta", "->", 
        RowBox[{"{", "q", "}"}]}], ",", 
       RowBox[{"ChangeDimension", "->", "d"}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"amp4", "=", 
     RowBox[{"FCFAConvert", "[", 
      RowBox[{"faAmp4", ",", 
       RowBox[{"IncomingMomenta", "->", 
        RowBox[{"{", 
         RowBox[{"p1", ",", "p2"}], "}"}]}], ",", 
       RowBox[{"OutgoingMomenta", "->", 
        RowBox[{"{", 
         RowBox[{"p3", ",", "p4"}], "}"}]}], ",", 
       RowBox[{"LoopMomenta", "->", 
        RowBox[{"{", "q", "}"}]}], ",", 
       RowBox[{"ChangeDimension", "->", "d"}], ",", 
       RowBox[{"List", "->", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
