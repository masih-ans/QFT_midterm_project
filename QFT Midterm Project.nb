     RowBox[{"Replace", " ", "model", " ", "parameters"}], ",", 
     RowBox[{
     "if", " ", "the", " ", "model", " ", "uses", " ", "these", " ", 
      "names"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"amp2", "=", 
     RowBox[{"amp2", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Mphi", "->", "m"}], ",", 
        RowBox[{"g", "->", "lambda"}]}], "}"}]}]}], ";"}], "\n", 
